{
  "description": "Inject the named local development environment into every Codex session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-context.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-context.mjs\"",
            "statusMessage": "Loading named development environment",
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
