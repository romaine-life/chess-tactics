packages/board-render/dist/
backend/generated/
npm-debug.log
.DS_Store

# BGM and all other media are hosted in backend-owned storage (see tofu/ and the
# runtime asset contract), never committed to the repo or baked into the image.
*.mp3

# OpenTofu local working artifacts. Provider versions + the lockfile are injected
# by the shared pipeline (see tofu/provider.tf), so neither is committed here.
.terraform/
.terraform.lock.hcl

# Local Claude Code tooling: worktrees, launch config, and a scratch dir used
# for headless screenshot capture (Playwright + Chromium). Never committed —
# except checked-in skills under .claude/skills/ and the session hook in
# .claude/settings.json, which ship with the repo.
.claude/*
!.claude/skills/
!.claude/settings.json
.pwshot/
frontend/.codex-vite-*.log
frontend/.chrome-campaign-proof/
tmp-shots/
frontend/tmp-dev/
frontend/tmp-review/
.unit-art-output/
docs/art/**/runs/evidence/

# Advance Wars ROMs — copyrighted, never commit (see tools/aw-import)
roms/
frontend/public/dev-filtered/

# Blender tuning labs. Too big for git (the no-committed-media guard refuses them) and
# they must NOT live in %TEMP%, which is where the king lab was destroyed. One artifact
# per piece, driven directly by render_from_lab.py.
blender-labs/
