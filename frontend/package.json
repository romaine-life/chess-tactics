{
  "name": "chess-tactics-frontend",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-vite-dev.mjs",
    "build": "node scripts/check-no-committed-media.mjs && node scripts/check-ui-surface-contract.mjs && node scripts/check-presentation-architecture.mjs && node scripts/check-rail-tab-primitive.mjs && vite build && node scripts/check-no-committed-media.mjs --built-output-only",
    "build:trainer": "vite build --config vite.trainer.config.js",
    "build:board-render": "npm --prefix ../packages/board-render run build",
    "preview": "vite preview --host 0.0.0.0",
    "shot": "node scripts/shot.mjs",
    "shot:assembly": "node scripts/capture-board-assembly.mjs",
    "predrawn:detect": "node scripts/detect-predrawn-board.mjs",
    "predrawn:build-run": "node scripts/build-predrawn-generation-run.mjs",
    "predrawn:prepare": "node scripts/prepare-predrawn-generation-run.mjs",
    "e2e:lobby": "node scripts/lobby-e2e.mjs",
    "e2e:run-battle": "node scripts/run-battle-e2e.mjs",
    "e2e:run-transition": "node scripts/run-battle-e2e.mjs --transition-only",
    "e2e:run-deployment": "node scripts/run-battle-e2e.mjs --deployment-only",
    "e2e:run-scene-resume": "node scripts/run-scene-resume-e2e.mjs",
    "e2e:level-editor-pan": "node scripts/level-editor-pan-e2e.mjs",
    "vendor:ambience": "node scripts/vendor-ambience.mjs",
    "assets:build:macro-tiles": "python scripts/build-macro-tiles.py",
    "units:native": "python ../scripts/generate-unit-art.py",
    "optimize:assets": "node scripts/optimize-main-menu-assets.mjs",
    "visual:screenshot": "node scripts/screenshot-local-page.mjs",
    "visual:health": "node scripts/check-local-server.mjs",
    "verify:titlebar": "node scripts/check-titlebar-geometry.mjs",
    "verify:workspace": "node scripts/check-workspace-geometry.mjs",
    "verify:play-transition": "node scripts/check-play-transition.mjs",
    "verify:unit-arrival": "node scripts/verify-unit-arrival.mjs",
    "cards:check-prompts": "node scripts/install-run-card-art-prompts.mjs --dry-run",
    "cards:install-art": "node scripts/install-run-card-art-prompts.mjs --install-images",
    "typecheck": "tsc --noEmit",
    "check:presentation": "node scripts/check-presentation-architecture.mjs",
    "pretest": "npm run build:board-render",
    "test": "vitest run",
    "precheck": "npm run build:board-render",
    "check": "node --check src/bgm.js && node scripts/check-no-committed-media.mjs && node scripts/check-ui-surface-contract.mjs && node scripts/check-presentation-architecture.mjs && node --test scripts/check-ui-surface-contract.node-test.mjs && node scripts/check-bgm-shuffle.mjs && node scripts/check-imagegen-gate.mjs && node scripts/check-light-art-chrome.mjs && node scripts/check-titlebar-actions.mjs && node scripts/check-empty-panel-frame-overlay.mjs && node scripts/check-level-editor-chrome.mjs && node --test scripts/check-level-editor-chrome.node-test.mjs && node scripts/check-shared-primitives.mjs && node --test scripts/check-shared-primitives.node-test.mjs && node scripts/check-rail-tab-primitive.mjs && node scripts/check-no-dev-data-seam.mjs && node scripts/check-auth-session-owner.mjs && node --test scripts/check-auth-session-owner.node-test.mjs && node scripts/check-decision-log-index.mjs && node --test scripts/check-decision-log-index.node-test.mjs && node scripts/check-doc-links.mjs && node --test scripts/check-doc-links.node-test.mjs && npm run cards:check-prompts && vitest run && tsc --noEmit",
    "check:media-final": "node scripts/check-no-committed-media.mjs",
    "verify:strategikon": "node scripts/check-strategikon-transition.mjs",
    "verify:run-scenes": "node scripts/check-run-scene-transitions.mjs",
    "verify:grant-carry": "node scripts/check-run-grant-carry.mjs",
    "verify:board-selection": "node scripts/verify-board-selection.mjs",
    "verify:premove-cancel": "node scripts/verify-premove-cancel.mjs",
    "verify:royal-fork": "node scripts/verify-royal-fork-bounty.mjs",
    "verify:manubiae": "node scripts/verify-manubiae.mjs",
    "verify:icon-seats": "node scripts/verify-icon-seats.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@chess-tactics/board-render": "file:../packages/board-render",
    "@huggingface/transformers": "3.8.1",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  }
}
